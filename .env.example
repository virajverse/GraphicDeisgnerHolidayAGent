# Taliyo Creative Intelligence Environment Config
PORT=3000
NODE_ENV=development

# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Primary AI Provider — NVIDIA Cloud NIM API (openai/gpt-oss-120b)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Turso Cloud SQLite Config (For Vercel Serverless Hosting)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Admin Invite & Access Security Code
ADMIN_INVITE_CODE=your_admin_invite_code_here
ADMIN_TELEGRAM_HANDLE=@your_admin_handle
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Notification Settings
DEFAULT_LEAD_DAYS=2
MIN_RELEVANCE_SCORE=40
TELEGRAM_DEFAULT_CHAT_ID=
