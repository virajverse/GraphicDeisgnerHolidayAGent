# ==============================================================================
# TALIYO CREATIVE INTELLIGENCE — ENVIRONMENT TEMPLATE (.ENV.EXAMPLE)
# ==============================================================================
# All dynamic business configs (Passcodes, Admin handles, Lead days)
# are stored securely in Turso Cloud Database (`system_settings` table).
# ==============================================================================

PORT=3000
NODE_ENV=development

# 1. Telegram Bot Token (From @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. NVIDIA NIM & FLUX.2 API Key (From build.nvidia.com)
NVIDIA_API_KEY=nvapi-your_nvidia_key_here

# 3. Turso Cloud Distributed Database (From turso.tech)
TURSO_DATABASE_URL=libsql://your-database-name.aws-region.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here
